{
  "version": 2,
  "builds": [
    {
      "src": "api.js",
      "use": "@vercel/node"
    },
    {
      "src": "acoes-nz-api.js",
      "use": "@vercel/node"
    },
    {
      "src": "moderator-option-delete.js",
      "use": "@vercel/node"
    },
    {
      "src": "duel-bottom-api.js",
      "use": "@vercel/node"
    },
    {
      "src": "page.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["index.html"]
      }
    },
    {
      "src": "institutional.js",
      "use": "@vercel/node"
    },
    {
      "src": "sitemap.js",
      "use": "@vercel/node"
    },
    {
      "src": "og-topo.png",
      "use": "@vercel/static"
    },
    {
      "src": "og-topo-v2.png",
      "use": "@vercel/static"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "acoes-nz.html",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "pop-electric.css",
      "use": "@vercel/static"
    },
    {
      "src": "editorial-clean.css",
      "use": "@vercel/static"
    },
    {
      "src": "logo-topo.svg",
      "use": "@vercel/static"
    },
    {
      "src": "logo-topo-v2.svg",
      "use": "@vercel/static"
    },
    {
      "src": "logo-topo-v3.svg",
      "use": "@vercel/static"
    },
    {
      "src": "logo-topo-footer-v3.svg",
      "use": "@vercel/static"
    },
    {
      "src": "logo-topo-v4.svg",
      "use": "@vercel/static"
    },
    {
      "src": "logo-topo-footer-v4.svg",
      "use": "@vercel/static"
    },
    {
      "src": "logo-topo-v5.svg",
      "use": "@vercel/static"
    },
    {
      "src": "logo-topo-footer-v5.svg",
      "use": "@vercel/static"
    },
    {
      "src": "logo-topo-v6.svg",
      "use": "@vercel/static"
    },
    {
      "src": "logo-topo-footer-v6.svg",
      "use": "@vercel/static"
    },
    {
      "src": "topo-mark.svg",
      "use": "@vercel/static"
    },
    {
      "src": "topo-mark-v2.svg",
      "use": "@vercel/static"
    },
    {
      "src": "topo-mark-v3.svg",
      "use": "@vercel/static"
    },
    {
      "src": "topo-mark-v4.svg",
      "use": "@vercel/static"
    },
    {
      "src": "topo-mark-v5.svg",
      "use": "@vercel/static"
    },
    {
      "src": "og-topo-v3.png",
      "use": "@vercel/static"
    },
    {
      "src": "topo-mark-v6.svg",
      "use": "@vercel/static"
    },
    {
      "src": "og-topo-v4.png",
      "use": "@vercel/static"
    },
    {
      "src": "topo-local.js",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "duel-option-photos.js",
      "use": "@vercel/static"
    },
    {
      "src": "editorial-*.js",
      "use": "@vercel/static"
    },
    {
      "src": "covers/**/*.svg",
      "use": "@vercel/static"
    },
    {
      "src": "social/*.jpg",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    {
      "src": "/api",
      "dest": "/api.js"
    },
    {
      "src": "/acoes-nz-api",
      "dest": "/acoes-nz-api.js?market=tokyo"
    },
    {
      "src": "/acoes-tokyo-api",
      "dest": "/acoes-nz-api.js?market=tokyo"
    },
    {
      "src": "/acoes-status-api",
      "dest": "/acoes-nz-api.js?status=all"
    },
    {
      "src": "/acoes-bovespa-api",
      "dest": "/acoes-nz-api.js?market=bovespa"
    },
    {
      "src": "/acoes-frankfurt-api",
      "dest": "/acoes-nz-api.js?market=frankfurt"
    },
    {
      "src": "/acoes-madrid-api",
      "dest": "/acoes-nz-api.js?market=madrid"
    },
    {
      "src": "/acoes-paris-api",
      "dest": "/acoes-nz-api.js?market=paris"
    },
    {
      "src": "/acoes-londres-api",
      "dest": "/acoes-nz-api.js?market=london"
    },
    {
      "src": "/acoes-nova-york-api",
      "dest": "/acoes-nz-api.js?market=newyork"
    },
    {
      "src": "/acoes-dow-jones-api",
      "dest": "/acoes-nz-api.js?market=newyork"
    },
    {
      "src": "/acoes-australia-api",
      "dest": "/acoes-nz-api.js?market=australia"
    },
    {
      "src": "/acoes-coreia-api",
      "dest": "/acoes-nz-api.js?market=korea"
    },
    {
      "src": "/acoes-china-api",
      "dest": "/acoes-nz-api.js?market=china"
    },
    {
      "src": "/acoes-mexico-api",
      "dest": "/acoes-nz-api.js?market=mexico"
    },
    {
      "src": "/acoes-moedas-api",
      "dest": "/acoes-nz-api.js?market=currencies"
    },
    {
      "src": "/moderator-option-delete",
      "dest": "/moderator-option-delete.js"
    },
    {
      "src": "/duel-bottom-api",
      "dest": "/duel-bottom-api.js"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.js"
    },
    {
      "src": "/acoes-nz/([^/]+)/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-tokyo/([^/]+)/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-bovespa/([^/]+)/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-frankfurt/([^/]+)/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-madrid/([^/]+)/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-paris/([^/]+)/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-londres/([^/]+)/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-nova-york/([^/]+)/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-dow-jones/([^/]+)/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-australia/([^/]+)/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-coreia/([^/]+)/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-china/([^/]+)/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-mexico/([^/]+)/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-moedas/([^/]+)/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-nz/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-tokyo/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-bovespa/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-frankfurt/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-madrid/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-paris/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-londres/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-nova-york/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-dow-jones/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-australia/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-coreia/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-china/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-mexico/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/acoes-moedas/?",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/",
      "dest": "/acoes-nz.html"
    },
    {
      "src": "/rankings/([^/]+)/?",
      "dest": "/page.js?view=discover&slug=$1"
    },
    {
      "src": "/rankings/?",
      "dest": "/page.js?view=discover"
    },
    {
      "src": "/descobrir/([^/]+)/?",
      "dest": "/page.js?view=discover-legacy&slug=$1"
    },
    {
      "src": "/descobrir/?",
      "dest": "/page.js?view=discover-legacy"
    },
    {
      "src": "/favoritos/([^/]+)/?",
      "dest": "/page.js?view=private&kind=favoritos"
    },
    {
      "src": "/afinidade/([^/]+)/?",
      "dest": "/page.js?view=private&kind=afinidade"
    },
    {
      "src": "/(entrar|perfil|moderacao|vip|recuperar-senha|redefinir-senha|sso-callback)/?",
      "dest": "/page.js?view=private&kind=$1"
    },
    {
      "src": "/local/([^/]+)/([^/]+)/?",
      "dest": "/page.js?view=local&city=$1&local_category=$2"
    },
    {
      "src": "/local/([^/]+)/?",
      "dest": "/page.js?view=local&city=$1"
    },
    {
      "src": "/local/?",
      "dest": "/page.js?view=local"
    },
    {
      "src": "/categoria/futebol/times/?",
      "dest": "/page.js?view=category&category=futebol&section=times"
    },
    {
      "src": "/categoria/esporte/times/?",
      "dest": "/page.js?view=category&category=futebol&section=times"
    },
    {
      "src": "/categoria/([^/]+)/?",
      "dest": "/page.js?view=category&category=$1"
    },
    {
      "src": "/ranking/([^/]+)/?",
      "dest": "/page.js?id=$1"
    },
    {
      "src": "/(sobre|como-funciona|imprensa|anuncie|contato|denuncie|regras|seguranca|privacidade|termos|cookies|direitos-autorais)/?",
      "dest": "/institutional.js?slug=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/page.js?view=not-found"
    }
  ]
}
