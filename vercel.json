{
  "version": 2,
  "alias": ["somostopo.com.br"],
  "builds": [
    { "src": "api.js", "use": "@vercel/node" },
    { "src": "page.js", "use": "@vercel/node", "config": { "includeFiles": ["index.html"] } },
    { "src": "institutional.js", "use": "@vercel/node" },
    { "src": "sitemap.js", "use": "@vercel/node" },
    { "src": "og-topo.png", "use": "@vercel/static" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "style.css", "use": "@vercel/static" },
    { "src": "pop-electric.css", "use": "@vercel/static" },
    { "src": "logo-topo.svg", "use": "@vercel/static" },
    { "src": "topo-mark.svg", "use": "@vercel/static" },
    { "src": "topo-local.js", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "editorial-*.js", "use": "@vercel/static" },
    { "src": "social/*.jpg", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    { "src": "/api", "dest": "/api.js" },
    { "src": "/sitemap.xml", "dest": "/sitemap.js" },
    { "src": "/", "dest": "/page.js?view=home" },
    {
      "src": "/(entrar|perfil|moderacao|recuperar-senha|redefinir-senha|sso-callback)/?",
      "dest": "/page.js?view=private&kind=$1"
    },
    {
      "src": "/local/([^/]+)/([^/]+)/?",
      "dest": "/page.js?view=local&city=$1&local_category=$2"
    },
    { "src": "/local/([^/]+)/?", "dest": "/page.js?view=local&city=$1" },
    { "src": "/local/?", "dest": "/page.js?view=local" },
    { "src": "/categoria/([^/]+)/?", "dest": "/page.js?view=category&category=$1" },
    { "src": "/ranking/([^/]+)/?", "dest": "/page.js?id=$1" },
    {
      "src": "/(sobre|como-funciona|imprensa|anuncie|contato|denuncie|regras|seguranca|privacidade|termos|cookies|direitos-autorais)/?",
      "dest": "/institutional.js?slug=$1"
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/page.js?view=not-found" }
  ]
}
