{
  "name": "topo-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check api.js && node --check app.js",
    "test": "node --test test/*.test.mjs",
    "validate": "npm run check && npm test && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:images": "node scripts/audit-ranking-images.mjs --site https://somostopo.com.br",
    "audit:images:local": "node scripts/audit-ranking-images.mjs --strict",
    "dev": "node test/dev-server.mjs",
    "test:engagement": "node test/engagement-flow.test.mjs",
    "test:voting-flow": "node test/ranking-voting-flow.test.mjs",
    "test:image-audit": "node test/image-audit.test.mjs",
    "db:comments": "node scripts/apply-comments.mjs",
    "db:clerk": "node scripts/apply-clerk.mjs",
    "db:suggestions": "node scripts/apply-suggestions.mjs",
    "test:api": "node test/api.integration.mjs",
    "test:comments": "node test/comments.integration.mjs",
    "test:priority": "node test/priority.test.mjs",
    "test:suggestions": "node test/suggestions.test.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.10",
    "@neondatabase/serverless": "^1.0.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
